FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
# Skip @playwright/test's postinstall browser-binary download - it's only needed for
# e2e (not run in this image) and its ~300MB download is what was making npm ci
# time out/ECONNRESET on constrained build networks.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci

FROM deps AS runtime
COPY . .
EXPOSE 5173
# The Medusa publishable key is generated by the seed script inside the DB, so it
# doesn't exist at "docker compose build" time - only once the backend container has
# migrated+seeded (which "depends_on: condition: service_healthy" guarantees has
# already happened by the time this CMD runs). Fetching /key-exchange here is a
# server-to-server call, so it isn't subject to the STORE_CORS restriction that blocks
# browsers from calling it directly (see src/lib/sdk.ts). Vite only inlines
# import.meta.env.VITE_* at build time, so the fetch + build must happen together here,
# not at image-build time.
# INTERNAL_MEDUSA_URL is the docker-network address (e.g. http://backend:9000) used only
# for this container-to-container fetch; VITE_MEDUSA_BACKEND_URL is the browser-facing
# address (e.g. http://localhost:9000) that ends up baked into the built bundle. They
# differ because this container does NOT share the backend's network namespace (unlike
# the old Next.js storefront, this is a client-only SPA with no server-side rendering,
# so there's no need for the two to resolve identically).
CMD ["sh", "-c", "export VITE_MEDUSA_PUBLISHABLE_KEY=$(node -e \"fetch((process.env.INTERNAL_MEDUSA_URL || process.env.VITE_MEDUSA_BACKEND_URL) + '/key-exchange').then(r => r.json()).then(d => process.stdout.write(d.publishableApiKey || ''))\") && npm run build && npm run preview -- --host 0.0.0.0 --port 5173"]
