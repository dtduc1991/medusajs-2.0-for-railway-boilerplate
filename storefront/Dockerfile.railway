FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.10.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml .yarnrc.yml ./
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
# Unlike storefront/Dockerfile (used for local docker-compose, where images build before
# any container starts, so the backend isn't reachable yet), on Railway the backend is
# already deployed and publicly reachable when this image builds. Building here - rather
# than at container start - also avoids OOM crashes: Railway's build machines have far
# more RAM available than this service's runtime memory limit, and "next build" needs
# more than that limit allows.
ARG NEXT_PUBLIC_MEDUSA_BACKEND_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_REGION
ARG NEXT_PUBLIC_SEARCH_ENDPOINT
ARG NEXT_PUBLIC_SEARCH_API_KEY
ARG NEXT_PUBLIC_INDEX_NAME
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=$NEXT_PUBLIC_MEDUSA_BACKEND_URL \
    NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL \
    NEXT_PUBLIC_DEFAULT_REGION=$NEXT_PUBLIC_DEFAULT_REGION \
    NEXT_PUBLIC_SEARCH_ENDPOINT=$NEXT_PUBLIC_SEARCH_ENDPOINT \
    NEXT_PUBLIC_SEARCH_API_KEY=$NEXT_PUBLIC_SEARCH_API_KEY \
    NEXT_PUBLIC_INDEX_NAME=$NEXT_PUBLIC_INDEX_NAME
RUN npm run build

FROM build AS runtime
EXPOSE 8000
CMD ["npm", "run", "start"]
